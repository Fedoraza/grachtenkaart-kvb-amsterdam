AISSTREAM_API_KEY=replace-with-your-aisstream-key
HOST=0.0.0.0
PORT=5173
AIS_HISTORY_DAYS=30
AIS_HISTORY_SAMPLE_MS=5000
AIS_MOVING_STALE_MS=900000
AIS_STATIONARY_STALE_MS=900000
AIS_REMOVE_AFTER_MS=2592000000
AIS_WATCHDOG_MS=120000
# Capacity controls for live AIS clients. Guests are limited per source IP,
# while WEBSOCKET_GLOBAL_LIMIT protects the single application instance.
WEBSOCKET_GUEST_PER_IP_LIMIT=10
WEBSOCKET_GLOBAL_LIMIT=500
WEBSOCKET_MAX_BUFFERED_BYTES=1000000
AIS_BATCH_INTERVAL_MS=750
# Temporary operational data retention. AIS is always capped at 30 days even if
# AIS_HISTORY_DAYS is configured higher.
PLANNING_CONTEXT_RETENTION_DAYS=14
WHATSAPP_INBOX_RETENTION_DAYS=30
PLANNING_SOURCE_RETENTION_DAYS=90
BOAT_DUTY_RETENTION_DAYS=400
# Daily operational backup. AIS positions and vessel snapshots are deliberately
# removed from backups so AIS data cannot outlive its 30-day retention period.
DATABASE_BACKUP_DIRECTORY=data/backups
DATABASE_BACKUP_RETENTION_DAYS=14
# Enable this only when the app is served over HTTPS.
AUTH_SECURE_COOKIE=false
# Strong, random token required only while creating the first administrator.
# Always set this before exposing a fresh database to the internet.
AUTH_SETUP_TOKEN=
# Optional fallback if Baileys reports the linked account as a privacy ID.
WHATSAPP_VERIFICATION_NUMBER=+31612345678
WHATSAPP_ENABLED=false
